.container {
  padding: 40rpx 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
}

.title {
  font-size: 56rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

.input-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  margin-top: 20rpx;
}

.url-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  padding: 20rpx;
  background: #f9f9f9;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.parse-btn {
  width: 100%;
  height: 88rpx;
  background: #f69d44;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.history-btn {
  width: 100%;
  height: 88ptx;
  background: #fff;
  color: #f69d44;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: 2rpx solid #f69d44;
  display: flex;
  align-items: center;
  justify-content: center;
}

.history-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.history-name {
  font-size: 30rpx;
  color: #333;
}

.history-platform {
  font-size: 24rpx;
  color: #999;
}