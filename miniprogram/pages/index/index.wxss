page {
  background: #FDF6EC;
}

.container {
  padding: 60rpx 50rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.logo {
  width: 280rpx;
  height: 100rpx;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #8a8a7a;
  line-height: 1.6;
}

.hero-pot {
  width: 500rpx;
  height: 400rpx;
  margin: 30rpx 0;
}

.input-section {
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
  border: 2rpx solid #e8e0d0;
}

.url-input {
  width: 100%;
  min-height: 80rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.parse-btn {
  width: 100%;
  height: 96rpx;
  background: #e85d2c;
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 50rpx;
  margin-bottom: 10rpx;
  letter-spacing: 4rpx;
}

.divider {
  display: flex;
  align-items: center;
  width: 100%;
  margin-bottom: 40rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #d4c9b5;
}

.leaf-icon {
  width: 50rpx;
  height: 50rpx;
  margin: 0 20rpx;
}

.history-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.notebook-icon {
  width: 60rpx;
  height: 60rpx;
}

.history-text {
  font-size: 30rpx;
  color: #5a5a4a;
  font-weight: bold;
}