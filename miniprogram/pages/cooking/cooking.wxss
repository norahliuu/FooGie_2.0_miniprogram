.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.progress {
  margin-bottom: 40rpx;
}

.progress-text {
  font-size: 28rpx;
  color: #999;
  display: block;
  text-align: center;
  margin-bottom: 16rpx;
}

.progress-bar {
  width: 100%;
  height: 8rpx;
  background: #e0e0e0;
  border-radius: 4rpx;
}

.progress-fill {
  height: 100%;
  background: #f69d44;
  border-radius: 4rpx;
  transition: width 0.3s;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  min-height: 500rpx;
}

.step-badge {
  width: 80rpx;
  height: 80rpx;
  background: #f69d44;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
}

.step-content {
  font-size: 70rpx;
  color: #333;
  line-height: 1.8;
  text-align: center;
}

.check-area {
  display: flex;
  align-items: center;
  margin-top: 50rpx;
  padding: 16rpx 30rpx;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #ccc;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 28rpx;
  color: #fff;
}

.checkbox.checked {
  background: #f69d44;
  border-color: #f69d44;
}

.check-text {
  font-size: 28rpx;
  color: #999;
}

.nav-buttons {
  display: flex;
  gap: 20rpx;
  width: 100%;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.nav-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: nowrap;
}

.prev-btn {
  background: #fff;
  color: #666;
  border: 2rpx solid #ddd;
}

.prev-btn[disabled] {
  background: #f5f5f5;
  color: #ccc;
  border-color: #eee;
}

.next-btn {
  background: #f69d44;
  color: #fff;
}

.done-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.done-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 80%;
}

.done-emoji {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.done-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.done-subtitle {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.done-btn {
  width: 100%;
  height: 88rpx;
  background: #f69d44;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.happy-pot {
  width: 300rpx;
  height: 400rpx;
  margin: 30rpx 0;
}