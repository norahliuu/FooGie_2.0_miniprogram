.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.add-btn {
  font-size: 26rpx;
  color: #ff6b35;
  padding: 8rpx 20rpx;
  border: 1rpx solid #ff6b35;
  border-radius: 20rpx;
}

.title-input {
  width: 100%;
  font-size: 32rpx;
  padding: 16rpx 0;
  background: #f9f9f9;
  border-radius: 8rpx;
  margin-top: 16rpx;
  box-sizing: border-box;
}

.ingredient-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.ingredient-name {
  flex: 1;
  font-size: 28rpx;
  padding: 12rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
}

.ingredient-qty {
  width: 200rpx;
  font-size: 28rpx;
  padding: 12rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
  color: #ff6b35;
}

.delete-icon {
  font-size: 28rpx;
  color: #ccc;
  padding: 10rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.step-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.step-number {
  width: 48rpx;
  height: 48rpx;
  background: #ff6b35;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.step-arrows {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.arrow-btn {
  font-size: 24rpx;
  color: #666;
  padding: 4rpx 8rpx;
  text-align: center;
}

.arrow-btn.disabled {
  color: #ddd;
}

.step-input {
  flex: 1;
  font-size: 28rpx;
  padding: 12rpx;
  background: #f9f9f9;
  border-radius: 8rpx;
  line-height: 1.6;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background: #ff6b35;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}