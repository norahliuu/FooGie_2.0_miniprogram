<view class="container">
  <text class="recipe-title">{{recipe.title}}</text>

  <view class="section">
    <text class="section-title">食材清单</text>
    <view class="ingredient-list">
      <view class="ingredient-item {{checkedIngredients[index] ? 'checked' : ''}}" wx:for="{{recipe.ingredients}}" wx:key="index" bindtap="onToggleIngredient" data-index="{{index}}">
        <view class="ingredient-check">
          <view class="check-box {{checkedIngredients[index] ? 'checked' : ''}}">
            <text wx:if="{{checkedIngredients[index]}}">✓</text>
          </view>
        </view>
        <text class="ingredient-name {{checkedIngredients[index] ? 'checked-text' : ''}}">{{item.name}}</text>
        <text class="ingredient-qty {{checkedIngredients[index] ? 'checked-text' : ''}}">{{item.quantity}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <text class="section-title">烹饪步骤</text>
    <view class="step-item" wx:for="{{recipe.steps}}" wx:key="index">
      <view class="step-number">{{item.step}}</view>
      <text class="step-content">{{item.content}}</text>
    </view>
  </view>

  <view class="source-link" bindtap="onCopyLink">
    <text class="source-text">查看原视频</text>
    <text class="copy-hint">点击复制链接</text>
  </view>
  <button class="edit-btn" bindtap="onEdit">编辑食谱</button>
  <button class="cook-btn" bindtap="onStartCooking">进入做饭模式</button>
</view>