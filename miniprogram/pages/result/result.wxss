.container {
  padding: 30rpx;
  background: #FDF6EC;
  min-height: 100vh;
}

.recipe-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  display: block;
  text-align: center;
  margin-bottom: 40rpx;
}

.section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
  width: 100%;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.source-link {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 30rpx;
}

.source-text {
  font-size: 26rpx;
  color: #f9713c;
}

.copy-hint {
  font-size: 22rpx;
  color: #999;
}

.ingredient-list {
  display: flex;
  flex-direction: column;
}

.ingredient-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  width: 100%;
}

.ingredient-name {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.ingredient-qty {
  font-size: 28rpx;
  color: #f9713c;
  flex-shrink: 0;
  margin-left: 20rpx;
  text-align: right;
}

.step-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.step-number {
  width: 48rpx;
  height: 48rpx;
  background: #f9713c;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  margin-top: 4rpx;
}

.step-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  flex: 1;
}

.cook-btn {
  width: 100%;
  height: 88rpx;
  background: #f9713c;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-btn {
  width: 100%;
  height: 88rpx;
  background: transparent;
  color: #f9713c;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: 2rpx solid #f9713c;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
}

.ingredient-check {
  margin-right: 16rpx;
}

.check-box {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
}

.check-box.checked {
  background: #f9713c;
  border-color: #f9713c;
}

.ingredient-item.checked {
  opacity: 0.5;
}

.checked-text {
  text-decoration: line-through;
  color: #ccc !important;
}